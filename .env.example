# Copy to .env and fill in. Defaults run fully offline.
ANTHROPIC_API_KEY=

# "extractive" (offline baseline) or "claude"
MEDTRACE_GENERATOR=extractive
MEDTRACE_CLAUDE_MODEL=claude-sonnet-5-5

# "hashing" (offline) or a sentence-transformers model
MEDTRACE_EMBEDDER=hashing
# MEDTRACE_EMBEDDER=BAAI/bge-small-en-v1.5

# "none" or a cross-encoder model
MEDTRACE_RERANKER=none
# MEDTRACE_RERANKER=cross-encoder/ms-marco-MiniLM-L-6-v2

MEDTRACE_TOP_K=5
MEDTRACE_MIN_RELEVANCE=0.15
MEDTRACE_SUPPORT_THRESHOLD=0.5
MEDTRACE_INDEX_DIR=index
